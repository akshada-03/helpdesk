# PostgreSQL connection for the local "helpdesk" database.
DATABASE_URL="postgresql://localhost:5432/helpdesk?schema=public"

# Better Auth — encryption secret (min 32 chars; generate with `openssl rand -base64 32`) and base URL.
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3001"

# Web client origin — trusted for cross-origin auth (CORS + Better Auth trustedOrigins).
CLIENT_URL="http://localhost:3000"

# Public base URL where this API is reachable. Required in production; defaults to
# the local server port in dev.
API_BASE_URL="http://localhost:3001"

# Seed admin user (used by prisma/seed.ts).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# AI provider — powers the AI features (reply polishing). Any OpenAI-compatible
# /chat/completions endpoint works (Gemini, Groq, OpenRouter, local Ollama), so the
# provider and model are config, not code (see src/lib/ai.ts). Leave unset to run
# the app without AI: everything else works, and polishing returns a 502.
#
# Below: Google Gemini via its OpenAI-compatible endpoint. Free key (no credit card)
# at https://aistudio.google.com/apikey.
#
# Prefer a `-latest` alias: Google retires specific Gemini versions for new keys, and
# the errors don't say so plainly. Two failures worth recognising, since both look
# like a broken key but are really the model id:
#   404 "no longer available to new users" — that version is retired (e.g. gemini-2.5-flash)
#   429 "limit: 0"                         — no FREE-tier quota for it (e.g. gemini-2.0-flash)
# Either way, change AI_MODEL. To see what a key can actually use:
#   curl -H "Authorization: Bearer $AI_API_KEY" "${AI_BASE_URL}models"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_MODEL="gemini-flash-lite-latest"
AI_API_KEY="..."

# Optional shared secret for the inbound-email webhook (/api/webhooks/inbound-email).
# When set, the provider must include a matching `?token=` on the webhook URL.
# Leave unset in local dev / E2E so posts and tests work without a token.
# WEBHOOK_SECRET="a-long-random-string"

# --- Outbound email (SMTP, via nodemailer) ------------------------------------
# Sends agent + AI replies back to the requester's email. Entirely optional: leave
# unset and the app runs normally, just without emailing anyone (replies are still
# saved and shown in the UI). Any SMTP server works.
#
# FREE setup with Gmail (no cost, no card):
#   1. Use (or create) a Gmail account for the helpdesk.
#   2. Enable 2-Step Verification: https://myaccount.google.com/security
#   3. Create an "App Password": https://myaccount.google.com/apppasswords
#      (pick "Mail" / "Other") — it's a 16-char code. Use it as SMTP_PASS below,
#      NOT your normal Google password.
#   4. Fill in the values below with that account.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"          # true = implicit TLS (465); false = STARTTLS (587)
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# SMTP_FROM="Helpdesk Support <you@gmail.com>"   # optional; defaults to SMTP_USER

# --- Inbound email (IMAP polling, via imapflow) -------------------------------
# Polls a mailbox and turns each new (unread) email into a ticket — the self-hosted
# alternative to the SendGrid webhook above. Optional: unset means no polling. Reuses
# the SMTP login by default, so with the same Gmail account you only need the host.
#   - For Gmail, enable IMAP once in Gmail → Settings → "Forwarding and POP/IMAP".
#   - The same App Password from the SMTP step is used here.
# IMAP_HOST="imap.gmail.com"
# IMAP_PORT="993"
# IMAP_SECURE="true"          # implicit TLS (993); set "false" only for a plain server
# IMAP_USER="you@gmail.com"   # defaults to SMTP_USER
# IMAP_PASS="your-16-char-app-password"   # defaults to SMTP_PASS
# IMAP_POLL_SECONDS="60"      # how often to check for new mail (default 60)
