# PostgreSQL connection for the local "helpdesk" database.
DATABASE_URL="postgresql://localhost:5432/helpdesk?schema=public"

# Better Auth — encryption secret (min 32 chars; generate with `openssl rand -base64 32`) and base URL.
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3001"
