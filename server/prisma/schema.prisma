// Prisma 7 schema. Connection URLs live in prisma.config.ts (CLI) and the
// driver adapter (runtime), not here — see src/lib/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Better Auth core models (email/password + database sessions) ---

enum Role {
  admin
  agent
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(agent)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Soft delete: non-null means the user has been deactivated. Such users are
  // hidden from the admin list and blocked from signing in (see auth.ts), but
  // their row and audit trail are preserved.
  deletedAt     DateTime?
  sessions      Session[]
  accounts      Account[]
  // Tickets this user is the assigned agent for (see Ticket.assignee).
  assignedTickets Ticket[] @relation("TicketAssignee")
  // Replies this user has authored (see TicketReply.author).
  replies         TicketReply[] @relation("ReplyAuthor")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// --- Support tickets ---

enum TicketStatus {
  open
  resolved
  closed
}

enum TicketCategory {
  general_question
  technical_question
  refund_request
}

// A support ticket. Created from an inbound email (see routes/webhooks.ts).
// Requesters are external people (not app Users), so their identity is stored as
// plain fields. Category is set later by AI classification (not yet built), so it
// is nullable.
model Ticket {
  id             String          @id
  subject        String
  body           String
  requesterEmail String
  requesterName  String?
  status         TicketStatus    @default(open)
  category       TicketCategory?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  // Assigned agent (an app User). Null until an agent/admin picks up the ticket.
  // SetNull rather than Cascade so hard-deleting a user unassigns their tickets
  // instead of deleting them (users are normally soft-deleted anyway).
  assigneeId     String?
  assignee       User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Agent replies on this ticket, newest last (see TicketReply). Cascade so a
  // deleted ticket takes its thread with it.
  replies        TicketReply[]

  @@map("ticket")
}

// An agent/admin reply on a ticket — the thread shown below the inbound message.
// Requesters are external (email), so replies are always authored by an app User.
// `author` is nullable + SetNull (mirroring Ticket.assignee) so hard-deleting a
// user preserves the reply and its audit trail rather than deleting it.
enum ReplySenderType {
  agent
  customer
}

model TicketReply {
  id         String          @id
  ticketId   String
  ticket     Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body       String
  // Whether an app User (agent) or the requester (customer) wrote this reply.
  senderType ReplySenderType
  authorId   String?
  author     User?           @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@map("ticket_reply")
}

